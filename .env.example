VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Google SSO Credentials
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# VITE_FIREBASE_AUTH_DOMAIN — where Firebase's OAuth handler is served from.
#
# Local development: leave as <project>.firebaseapp.com.
#
# Production: set this to the app's OWN domain (e.g. subscription-ledger-react.vercel.app).
# Safari 16.1+ and iOS block third-party storage, which breaks Google sign-in when the
# auth handler lives on a different origin than the app. vercel.json proxies
# /__/auth/* to <project>.firebaseapp.com so the handler becomes same-origin and
# Safari treats it as first-party. Both halves are required: change this value
# WITHOUT the proxy rewrite in place and all sign-in breaks.
#
# The domain must also be listed in
# Firebase Console -> Authentication -> Settings -> Authorized domains.
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Turso Database Credentials (LibSQL Edge Engine)
VITE_TURSO_DATABASE_URL=libsql://your-database-name-username.turso.io
VITE_TURSO_AUTH_TOKEN=your_turso_auth_token_here
