# ET Prime Subscription Ledger - Environment Configuration

# 1. Gemini AI API Key (For Conversational Analytics)
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 2. Firebase & Google SSO Configuration
# Get these values from Firebase Console -> Project Settings -> Web App Config
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=et-prime-ledger.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=et-prime-ledger
VITE_FIREBASE_STORAGE_BUCKET=et-prime-ledger.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
